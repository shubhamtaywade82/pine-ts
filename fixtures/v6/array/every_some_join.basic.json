  "input": {
    "cases": [
      {
        "values": [1, 2, 3]
      },
      {
        "values": [1, 0, 3]
      },
      {
        "values": [1, null]
      },
      {
        "values": [0, 0]
      },
      {
        "values": [1.5, null, 3]
      }
    ]
  },
  "expected": {
    "every_some_join": [
      [true, true, "1,2,3"],
      [false, true, "1,0,3"],

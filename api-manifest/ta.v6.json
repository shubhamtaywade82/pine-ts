  "implemented": ["sma", "ema", "rma", "tr", "atr", "highest", "lowest", "change", "crossover", "crossunder"],
  "types": {
    "float": "number",
    "int": "number",
    "series<float>": "FloatSeries",
    "series<int>": "Series<number>",
    "series<bool>": "BooleanSeries",
    "tuple(series<float>,...)": "readonly [FloatSeries, ...]"
  },
  "variables": {
    "barstate": ["isfirst", "islast", "ishistory", "isrealtime", "isnew", "isconfirmed", "islastconfirmedhistory"],
    "syminfo": ["ticker", "timezone", "type"],
    "sources": ["open", "high", "low", "close", "volume", "time", "hl2", "hlc3", "ohlc4"]
  },
  "providerCapabilities": {
    "security": { "required": ["ohlcv"] },
    "financial": { "required": ["fundamentals"] }
  },
  "generation": {
    "strategy": "manifest-first",
    "rule": "generate declarations and coverage reports from this inventory; never generate silent placeholder implementations"
  },
  "policy": {
    "missingFunctions": "tracked",
    "providerSpecificData": "must fail explicitly",
    "seriesSemantics": "required",
    "realtimeSemantics": "required"
  }
}
